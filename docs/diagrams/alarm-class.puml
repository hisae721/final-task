' アラーム一覧表示を表示するクラス
class "AddDisplay & EditDisplay & RuleDisplay & ListDisplay & ModalDisplay" as Display {
    + constructor(private modal: ModalService)
    + renderAdd(): void
    + renderClose(): void

    + constructor(private modal: ModalService)
    + renderEdit(alarm: Alarm): void
    + renderClose(): void

    + renderRule(massage: string):void
    ' + renderMissedAlarm(): void;

    + renderList(alarms: Alarm[], selectedIds: Set<string>)

    + renderCloseAlertModal(): void
    + renderOpenAlertModal(props: {title: string; onStop: () => void;}): void
}

' 時刻形式
class TimeFormatter {
    '  ミリ秒を "HH:MM:SS.ms" 形式にフォーマットする。ストップウォッチ向け
    + formatMilliSeconds(milliseconds: number): string

    '  秒を "MM:SS" 形式にフォーマットする。タイマー向け
    + formatSeconds(seconds: number): string

    '  時・分を "HH:MM" 形式にフォーマットする。アラーム向け
    + formatHourMinute(hour: number, minute: number): string
    '  { 例: (9, 5) → "09:05" }
    - format(time: AlarmTime): string
}

