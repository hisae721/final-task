@startuml Class Diagram

note "DisplayGroup" as DGroup

' **使用関係**

Alarm *-- AlarmState
Alarm *-- AlarmTime

DGroup .. IDisplay
AlarmDisplayController .. DGroup
AlarmDisplayController --> Button
AlarmDisplayController --> ManagerService
AlarmDisplayController --> ExecutionService

AlarmDataManager --> LocalStorageManager

ManagerService --> AlarmList
ExecutionService --> SoundPlayer
ExecutionService --> TimeScheduler
ManagerService --> AlarmDataManager

IDisplay <|.. Display

Display --> TimeFormatter

ISoundPlayer <|.. SoundPlayer

' **列挙型**

enum AlarmState {
    ' アラームOFF
    DISABLED
    ' アラームONで待機(=WAITING)
    ENABLED
    ' 音が鳴る
    RINGING
}

enum ButtonType {
    ADD
    EDIT
    SAVE
    DELETE
    CLEAR
    CANCEL
}

' **インターフェース**

interface "IAddDisplay & IEditDisplay & IRuleDisplay & IListDisplay & IModalDisplay" as IDisplay {
    + renderAdd(): void
    + renderClose(): void

    + renderEdit(alarm: Alarm): void
    + renderClose(): void

    + renderRule(massage: string):void
    ' + renderMissedAlarm(): void;

    + renderList(alarms: Alarm[], selectedIds: Set<string>)

    + renderCloseAlertModal(): void
    + renderOpenAlertModal(props: {title: string; onStop: () => void;}): void
}

interface ISoundPlayer {
    - audio: HTMLAudioElement;
    + startSound(): void
    + stopSound(): void
}

