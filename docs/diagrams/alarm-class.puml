class Alarm {
    - time: AlarmTime
    - alarmId: string
    - state: AlarmState = AlarmState.ENABLED
    - selected: boolean = false
    
    + toggleOnOff(): void
    ' 汎用化以外での状態管理⇩⇩
    + isActive(): boolean 
    + startRinging(): void
    + stopRinging(): void
    + isSelected(): boolean 
    + toggleSelected(): void
    + updateTime(time: AlarmTime): void
    + getTime(): AlarmTime
    + getId(): string
    + getState(): AlarmState
    + static createAlarm(time: AlarmTime): Alarm
}

